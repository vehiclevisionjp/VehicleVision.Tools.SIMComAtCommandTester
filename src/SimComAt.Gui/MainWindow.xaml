<Window x:Class="VehicleVision.SimComAt.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIMCom AT Command Tester" Height="760" Width="1180" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="接続" Padding="10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="モデル" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ModelCombo" Width="245" DisplayMemberPath="DisplayName" SelectionChanged="ModelCombo_SelectionChanged" />
                <TextBlock Text="ポート" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="PortCombo" Width="90" />
                <Button Content="更新" Click="RefreshPorts_Click" Margin="5,0,0,0" Padding="10,3" />
                <TextBlock Text="ボーレート" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="BaudCombo" Width="100" IsEditable="True" Text="115200">
                    <ComboBoxItem Content="9600" /><ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="115200" /><ComboBoxItem Content="921600" />
                </ComboBox>
                <Button x:Name="ConnectButton" Content="接続" Click="Connect_Click" Margin="16,0,0,0" Padding="18,3" />
                <Button x:Name="DetectButton" Content="機種判定" Click="Detect_Click" Margin="6,0,0,0" Padding="12,3" IsEnabled="False" />
                <TextBlock x:Name="StatusText" Text="未接続" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="CommandText" Text="AT" FontFamily="Consolas" FontSize="15" Padding="7,5" KeyDown="CommandText_KeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Content="送信 (Enter)" Click="Send_Click" Margin="8,0,0,0" Padding="18,4" IsEnabled="False" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="470" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TabControl>
                <TabItem Header="ATコマンド">
                    <DataGrid x:Name="CommandGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="CommandGrid_MouseDoubleClick" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="コマンド" Binding="{Binding Command}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="APN / PDP">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="コンテキストID" VerticalAlignment="Center" />
                        <TextBox x:Name="ContextIdText" Grid.Column="1" Text="1" Margin="4" Padding="4" />
                        <TextBlock Grid.Row="1" Text="PDPタイプ" VerticalAlignment="Center" />
                        <ComboBox x:Name="PdpTypeCombo" Grid.Row="1" Grid.Column="1" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="IP" /><ComboBoxItem Content="IPV6" /><ComboBoxItem Content="IPV4V6" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="APN" VerticalAlignment="Center" />
                        <TextBox x:Name="ApnText" Grid.Row="2" Grid.Column="1" Margin="4" Padding="4" />
                        <TextBlock Grid.Row="3" Text="認証" VerticalAlignment="Center" />
                        <ComboBox x:Name="AuthCombo" Grid.Row="3" Grid.Column="1" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="なし" Tag="None" /><ComboBoxItem Content="PAP" Tag="Pap" />
                            <ComboBoxItem Content="CHAP" Tag="Chap" /><ComboBoxItem Content="PAPまたはCHAP" Tag="PapOrChap" />
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="ユーザー名" VerticalAlignment="Center" />
                        <TextBox x:Name="ApnUserText" Grid.Row="4" Grid.Column="1" Margin="4" Padding="4" />
                        <TextBlock Grid.Row="5" Text="パスワード" VerticalAlignment="Center" />
                        <PasswordBox x:Name="ApnPasswordText" Grid.Row="5" Grid.Column="1" Margin="4" Padding="4" />
                        <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Button x:Name="ApplyPdpButton" Content="APN・認証を設定" Click="ApplyPdp_Click" Padding="14,5" IsEnabled="False" />
                            <Button x:Name="AttachButton" Content="アタッチ" Click="Attach_Click" Margin="6,0,0,0" Padding="12,5" IsEnabled="False" />
                            <Button x:Name="ActivateButton" Content="PDP有効化" Click="Activate_Click" Margin="6,0,0,0" Padding="12,5" IsEnabled="False" />
                            <Button x:Name="DeactivateButton" Content="PDP無効化" Click="Deactivate_Click" Margin="6,0,0,0" Padding="12,5" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DimGray"
                                   Text="設定値はAT+CGDCONT / AT+CGAUTHで反映します。資格情報はログ上でマスクされ、保存されません。" />
                    </Grid>
                </TabItem>
                <TabItem Header="SMS">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="送信先" VerticalAlignment="Center" />
                        <TextBox x:Name="SmsDestinationText" Grid.Column="1" Margin="4" Padding="4" ToolTip="例: +819012345678" />
                        <TextBlock Grid.Row="1" Text="文字コード" VerticalAlignment="Center" />
                        <ComboBox x:Name="SmsEncodingCombo" Grid.Row="1" Grid.Column="1" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="GSM / ASCII（最大160文字）" Tag="Gsm" />
                            <ComboBoxItem Content="UCS2 / 日本語（最大70文字）" Tag="Ucs2" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="本文" Margin="0,8,0,0" />
                        <TextBox x:Name="SmsBodyText" Grid.Row="2" Grid.Column="1" Margin="4" Padding="6" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <Button x:Name="SendSmsButton" Grid.Row="3" Grid.ColumnSpan="2" Content="SMS送信" Click="SendSms_Click"
                                Margin="0,12,0,0" Padding="14,5" HorizontalAlignment="Left" IsEnabled="False" />
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DimGray"
                                   Text="本文は通信ログに出力しません。UCS2では送信先と本文を16進表現へ変換します。" />
                    </Grid>
                </TabItem>
                <TabItem Header="GNSS">
                    <StackPanel Margin="14">
                        <TextBlock Text="選択中の系列に対応するGNSSコマンドを自動的に使用します。" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="GnssOnButton" Content="GNSS電源ON" Click="GnssOn_Click" Padding="14,5" IsEnabled="False" />
                            <Button x:Name="GnssInfoButton" Content="測位情報取得" Click="GnssInfo_Click" Margin="6,0,0,0" Padding="14,5" IsEnabled="False" />
                            <Button x:Name="GnssOffButton" Content="GNSS電源OFF" Click="GnssOff_Click" Margin="6,0,0,0" Padding="14,5" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock Margin="0,14,0,0" Foreground="DimGray" TextWrapping="Wrap"
                                   Text="初回測位には屋外で数分かかる場合があります。アンテナ接続とモジュール仕様を確認してください。" />
                    </StackPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
            <GroupBox Grid.Column="2" Header="通信ログ" Padding="6">
                <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True" />
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="ログ消去" Click="ClearLog_Click" Padding="12,3" HorizontalAlignment="Left" />
            <TextBlock Text="※ 設定・接続・保守コマンドは通信状態を変更します。対象機種の最新版ATコマンドマニュアルを確認してください。"
                       Foreground="DimGray" VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
